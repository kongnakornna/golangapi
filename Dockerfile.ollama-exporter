# เปลี่ยนจาก 1.22-alpine เป็น 1.26-alpine
FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/ollama-exporter ./cmd/ollama-exporter

FROM alpine:3.21
COPY --from=build /out/ollama-exporter /usr/local/bin/ollama-exporter
EXPOSE 9309
ENTRYPOINT ["ollama-exporter"]