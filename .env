SERVER_APP_VERSION=v0.0.1
SERVER_PORT=5000
SERVER_MODE=Development
SERVER_PROCESS_TIMEOUT=60
SERVER_READ_TIMEOUT=5
SERVER_WRITE_TIMEOUT=5

LOGGER_ENCODING=console
LOGGER_LEVEL=debug

# MQTT broker (native run: host broker on 1885; docker overrides via ICMON_MQTT_BROKER in compose)
ICMON_MQTT_BROKER=mqtt://localhost:1885
# MQTT port (overrides the port in ICMON_MQTT_BROKER when set)
ICMON_MQTT_PORT=1885

POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME=icmongolang
POSTGRES_CONNECTION_TIMEOUT=10

REDIS_ADDR=localhost:6379
REDIS_DB=0

TASK_REDIS_ADDR=localhost:6379
TASK_REDIS_DB=1
TASK_REDIS_POOL_TIMEOUT=240

SMTP_EMAIL_TIMEOUT=30

INFLUXDB_TIMEOUT=30

# InfluxDB (optional; if URL/token unset the app skips InfluxDB).
# Docker run: http://influxdb:8086  |  Native run: http://localhost:9087
INFLUXDB_URL=http://localhost:9087
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin1234
# InfluxDB 2.x API auth is token-based (API token from DOCKER_INFLUXDB_INIT_ADMIN_TOKEN)
INFLUXDB_TOKEN=ALjPKgvnTT1on6kWWtkbTnk-XgCkXCgXQ3YtQJrO1x56t9pavcrJVtUSTCwwVGH3srchfUOhhyWimVYSUF9pnQ==
INFLUXDB_ORG=cmon_org
INFLUXDB_BUCKET=AIRCOM1

# Elasticsearch
# Docker run: http://localhost:9200  |  Native run: http://localhost:9200
ELASTICSEARCH_ADDRESSES=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=vector_embeddings
ELASTICSEARCH_TIMEOUT=10

# LLM embedding provider (Ollama OpenAI-compatible endpoint)
# Chat model served by the `ai` service (LangChainGo); default qwen3:4b (fast on CPU), override with e.g. OLLAMA_MODEL=deepseek-r1:7b
# Native run: http://localhost:11434/v1
# Docker run (compose overrides): http://ollama:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=nomic-embed-text
LLM_TIMEOUT=30
LLM_DIMS=768

JWT_SECRET_KEY=9056b94a8611363c2c43aa3760d65a48c834744b877b5041fa99a919d5aaf635
JWT_ISSUER=go-dev
JWT_ACCESS_TOKEN_EXPIRE_DURATION=3600
JWT_ACCESS_TOKEN_PRIVATE_
JWT_ACCESS_TOKEN_PUBLIC_
JWT_REFRESH_TOKEN_EXPIRE_DURATION=1440
JWT_REFRESH_TOKEN_PRIVATE_
JWT_REFRESH_TOKEN_PUBLIC_
# Report PDF download token (HS256 secret, >= 32 bytes; short-lived + scoped).
# Required for POST /reports/token and ?token= PDF links.
JWT_DOWNLOAD_TOKEN_SECRET=9056b94a8611363c2c43aa3760d65a48c834744b877b5041fa99a919d5aaf635

FIRST_SUPER_USER_EMAIL=root@gmail.com
FIRST_SUPER_USER_NAME=root
FIRST_SUPER_USER_PASSWORD=root_password
